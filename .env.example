# -------------------------------------------------------------
# Dum & Co. Environment Configuration
# -------------------------------------------------------------

# Next.js Frontend Configuration
NEXT_PUBLIC_APP_NAME="Dum & Co."
NEXT_PUBLIC_API_BASE_URL="/api/v1"

# Django Backend Configuration
DJANGO_SETTINGS_MODULE="config.settings.development"
DJANGO_DEBUG="True"
DJANGO_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Database Configuration (PostgreSQL)
POSTGRES_DB="dum_and_co"
POSTGRES_USER="dum_user"
POSTGRES_PASSWORD="dum_secure_password_here"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# Razorpay Sandbox Credentials
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_here"

# CORS & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
